# DOUL Supervision local-development configuration.
# Values below are disposable local defaults, not production secrets.

COMPOSE_PROJECT_NAME=doul-supervision-dev

# Published ports are bound to loopback by compose.dev.yml.
DOUL_API_PORT_PUBLISHED=8791
DOUL_WEB_PORT_PUBLISHED=5181
DOUL_POSTGRES_PORT_PUBLISHED=5432
DOUL_REDIS_PORT_PUBLISHED=6379
DOUL_OBJECT_STORAGE_PORT_PUBLISHED=9000
DOUL_OBJECT_STORAGE_CONSOLE_PORT_PUBLISHED=9001

DOUL_API_LOG_LEVEL=info

# Development data-service credentials.
DOUL_POSTGRES_DB=doul_supervision
DOUL_POSTGRES_USER=doul_dev
DOUL_POSTGRES_PASSWORD=local-postgres-only
DOUL_REDIS_PASSWORD=local-redis-only
DOUL_OBJECT_STORAGE_ACCESS_KEY=doul-dev
DOUL_OBJECT_STORAGE_SECRET_KEY=local-minio-only
DOUL_OBJECT_STORAGE_BUCKET=doul-supervision-dev

# Backend/Platform interface values.
# DATABASE_URL enables the PostgreSQL snapshot adapter in the development API.
# Leave DATABASE_URL empty only when intentionally using the SQLite fallback.
DATABASE_URL=postgresql://doul_dev:local-postgres-only@postgres:5432/doul_supervision
REDIS_URL=redis://:local-redis-only@redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_BUCKET=doul-supervision-dev
OBJECT_STORAGE_ACCESS_KEY=doul-dev
OBJECT_STORAGE_SECRET_KEY=local-minio-only
OBJECT_STORAGE_REGION=us-east-1
