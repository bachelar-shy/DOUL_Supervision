{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doul.example/schema/product_change_record_contract_v1.json",
  "title": "DOUL Product Baseline Change Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changeId",
    "baselineFrom",
    "baselineTo",
    "changeClass",
    "reason",
    "requestedBy",
    "decidedBy",
    "impactedContracts",
    "compatibility",
    "migrationRequired",
    "effectiveFrom",
    "acceptanceScenarioIds",
    "decision"
  ],
  "properties": {
    "changeId": {
      "type": "string",
      "pattern": "^PCR-[0-9]{4}-[0-9]{3,}$"
    },
    "baselineFrom": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "baselineTo": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "changeClass": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1
    },
    "decidedBy": {
      "type": "string",
      "minLength": 1
    },
    "impactedContracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "impactedRegisters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "impactedForms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FM-[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "impactedApiSurfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "string",
      "enum": [
        "no_semantic_change",
        "backward_compatible",
        "migration_required",
        "breaking"
      ]
    },
    "migrationRequired": {
      "type": "boolean"
    },
    "migrationPlanRef": {
      "type": "string",
      "minLength": 1
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    },
    "acceptanceScenarioIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-[A-Z]+-[0-9]{2}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "deferred"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "migrationRequired": {
            "const": true
          }
        },
        "required": [
          "migrationRequired"
        ]
      },
      "then": {
        "required": [
          "migrationPlanRef"
        ]
      }
    }
  ]
}
