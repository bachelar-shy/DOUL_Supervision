{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "measurement-payment-execution/1",
  "functionalId": "F-05",
  "status": "contract_defined_backend_not_implemented",
  "objects": {
    "contractBOQ": "InformationItem/ContractBOQ",
    "quantityMeasurement": "WorkItem/QuantityMeasurement",
    "paymentClaim": "WorkItem/PaymentClaim"
  },
  "decimalContract": {
    "authoritativeRepresentation": "canonical_decimal_string",
    "binaryFloatAuthoritative": false,
    "currencyRequiredForAmounts": true,
    "roundingRuleVersionedByProjectOrContract": true,
    "intermediatePrematureRoundingForbidden": true
  },
  "boundaries": {
    "scheduleProgressIsNotMeasuredQuantity": true,
    "inspectionPassIsNotPaymentApproval": true,
    "claimedQuantityIsNotVerifiedQuantity": true,
    "quantityVerificationIsNotPaymentRecommendation": true,
    "recommendationIsNotOwnerApproval": true,
    "ownerApprovalIsNotActualPayment": true,
    "claimedVerifiedRecommendedOwnerApprovedPaidRemainSeparate": true,
    "externalPaymentRecordedOnlyNoBankExecution": true
  },
  "boqVersioning": {
    "exactVersionRequired": true,
    "historicalClaimsKeepHistoricalBOQRef": true,
    "oldClaimsNeverRecomputedAgainstCurrentBOQ": true,
    "activationSupersedesPriorEffectiveWithoutDeletingHistory": true
  },
  "eligibility": {
    "measurementMayBeVerifiedWhilePaymentBlocked": true,
    "unapprovedVariationExcludedFromDefaultRecommendation": true,
    "duplicateClaimBlocked": true,
    "contractQuantityExcessNeedsApprovedBasis": true,
    "blockedItemsPreservedNotDeleted": true
  },
  "cumulative": {
    "previousCertificateExactRefWhenPresent": true,
    "cumulativeCertifiedEqualsPreviousPlusOwnerApproved": true,
    "cumulativePaidEqualsPreviousPlusPaid": "derived_from_previous_paid_plus_active_payment_records",
    "partialPaymentDoesNotChangeOwnerApprovedAmount": true
  },
  "ownerDecision": {
    "exactCurrentPaymentClaimVersionRequired": true,
    "ownerMayAdjustRecommendationWithoutChangingVerifiedOrRecommended": true,
    "technicalQuantityChangeRequiresMeasurementOrDecisionBasis": true
  },
  "register17": {
    "mode": "read_only",
    "rawStatusPatch": false,
    "stateChangesViaDomainCommandsOnly": true,
    "paymentRecordsAndCumulativeBothProjected": true
  },
  "machines": {
    "contract_boq": "ContractBOQ",
    "quantity_measurement": "QuantityMeasurement",
    "payment_claim": "PaymentClaim"
  },
  "recommendationCalculation": {
    "calculationRuleRefExactVersionRequired": true,
    "ruleStoredAsVersionedRequirementApplicability": true,
    "serverRecalculatesRecommendedAmount": true,
    "deductionComponentsReconcileAggregateFields": true,
    "roundingRuleAndResultPreservedInSnapshot": true,
    "uiFormulaAuthoritative": false
  },
  "actualPaymentRecord": {
    "appendOnlyPaymentRecords": true,
    "cumulativePaidDerivedFromActiveRecords": true,
    "duplicatePaymentReferenceRejectedAcrossProject": true,
    "correctionAndCancellationUseSupersedeTrace": true,
    "originalPaymentRecordNeverDeleted": true,
    "ownerApprovedAmountUnaffectedByPartialPayment": true
  }
}
