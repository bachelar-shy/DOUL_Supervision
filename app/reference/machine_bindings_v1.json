{
  "version": "1.0",
  "purpose": "Backend binding from Product machine names to HTTP collections and create authorities.",
  "machines": {
    "observation": {
      "collection": "observations",
      "create_authority": "create_observation"
    },
    "inspection": {
      "collection": "inspections",
      "create_authority": "submit_inspection_request"
    },
    "issue": {
      "collection": "issues",
      "create_authority": "issue_official_issue"
    },
    "rfi": {
      "collection": "rfis",
      "create_authority": "submit_rfi"
    },
    "change": {
      "collection": "changes",
      "create_authority": "propose_change"
    },
    "approval": {
      "collection": "approvals",
      "create_authority": "request_approval"
    },
    "action": {
      "collection": "actions",
      "create_authority": "create_action"
    },
    "decision": {
      "collection": "owner-decisions",
      "create_authority": "request_owner_decision"
    },
    "report": {
      "collection": "owner-reports",
      "create_authority": "author_report"
    },
    "analysis_run": {
      "collection": "analysis-runs",
      "create_authority": "create_analysis_run"
    },
    "safety_permit": {
      "collection": "safety-permits",
      "create_authority": "safety.permit.create"
    },
    "safety_stop_order": {
      "collection": "safety-stop-orders",
      "create_authority": "safety.stop.issue"
    },
    "safety_equipment_inspection": {
      "collection": "safety-equipment-inspections",
      "create_authority": "safety.equipment.create"
    },
    "schedule_baseline": {
      "collection": "schedule-baselines",
      "create_authority": "schedule.baseline.create"
    },
    "schedule_progress": {
      "collection": "schedule-progress-updates",
      "create_authority": "schedule.progress.submit"
    },
    "delay_event": {
      "collection": "delay-events",
      "create_authority": "schedule.delay.create"
    },
    "recovery_plan": {
      "collection": "recovery-plans",
      "create_authority": "schedule.recovery.request"
    }
  }
}
