{
  "name": "DOUL Supervision UI Design System",
  "version": "1.0",
  "source": "DOUL Digital Product UI Guidelines",
  "colors": {
    "primary": "#0B2E91",
    "primaryMuted": "#33518D",
    "primaryDeep": "#061B5C",
    "ink": "#030213",
    "slate900": "#0F172A",
    "slate700": "#334155",
    "slate600": "#475569",
    "slate500": "#64748B",
    "slate300": "#CBD5E1",
    "line": "#E2E8F0",
    "surface": "#FFFFFF",
    "surfaceAlt": "#F8FAFC",
    "surfaceTint": "#F3F6FB",
    "success": "#127A4A",
    "warning": "#B45309",
    "danger": "#D4183D"
  },
  "spacing": {
    "base": 4,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "section": 64,
    "pageXMobile": 16,
    "pageXDesktop": 32
  },
  "radius": {
    "xs": 2,
    "sm": 4,
    "md": 6,
    "lg": 8,
    "full": 999
  },
  "density": {
    "controlHeight": 40,
    "touchControlHeight": 44,
    "tableRowMin": 40,
    "tableRowMax": 56,
    "contentMax": 1280
  },
  "typography": {
    "fontSans": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Noto Sans KR, Noto Sans, Arial, sans-serif",
    "fontData": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "headline": 32,
    "title": 24,
    "body": 16,
    "bodySm": 14,
    "label": 13,
    "data": 13
  },
  "principles": [
    "업무 규칙보다 UI가 우선하지 않는다.",
    "핵심 상태·담당·기한·증빙·다음 행동을 첫 화면에서 확인한다.",
    "카드보다 표·분할패널·도구막대를 우선한다.",
    "파랑은 브랜드와 선택·주요 행동에 제한적으로 사용한다.",
    "상태색은 의미 전달용이며 색상만으로 상태를 구분하지 않는다.",
    "모바일 현장 입력은 44px 이상의 터치 영역을 확보한다."
  ]
}
